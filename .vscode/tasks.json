{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "バックエンド起動 (FastAPI)",
      "type": "shell",
      "command": "uvicorn main:app --reload --port 8000",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "フロントエンド起動 (Vite)",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "全サーバー並行起動",
      "dependsOn": [
        "バックエンド起動 (FastAPI)",
        "フロントエンド起動 (Vite)"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
